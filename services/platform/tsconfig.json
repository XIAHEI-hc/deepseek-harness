{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "vitest.e2e.config.ts",
    // Gateway tests sign assertions and verify them with the runtime's own
    // verifier so the two implementations cannot drift.
    "../../packages/host/authentication-gateway/src/assertion.ts",
    "../../packages/host/authentication-gateway/src/replay.ts"
  ]
}
