# DSH 多用户平台部署环境示例。
#
# 复制为 deploy/.env（或由运维注入到编排环境），不要提交真实值。
# 生产必须：APP_ENV=production、AUTH_MODE=w3、AUTH_COOKIE_SECURE=true、
# DSH_GATEWAY_PUBLIC_URL 为 https、W3 四个端点均为 https、
# DSH_INTERNAL_API_KEY / DSH_PLATFORM_SPACE_KEY_SECRET 长度 >=32、
# DSH_RUNTIME_KIND=container、DSH_RUNTIME_IMAGE 指向不可变 digest。

# ── 部署环境 ───────────────────────────────────────────────────────────────
APP_ENV=development
# 开发/测试可用 mock；生产必须是 w3。
AUTH_MODE=mock
DSH_PLATFORM_REALM=dsh

# 平台数据根（身份库、运行时注册表、Gateway 密钥、备份）。
# 开发默认 ./.dsh-platform；生产示例 /srv/dsh/management。
DSH_PLATFORM_DATA_DIR=/srv/dsh/management
DSH_PLATFORM_REPO_ROOT=/srv/dsh/current

# ── 元数据数据库（身份/会话/审计）──────────────────────────────────────────
# sqlite：单机默认，数据位于 DSH_PLATFORM_DATA_DIR；postgres：生产推荐。
DSH_PLATFORM_STORAGE=sqlite
# DSH_PLATFORM_STORAGE=postgres 时必填；只用于平台身份库，用户 Runtime 数据仍在各自空间。
DSH_POSTGRES_URL=

# ── 公开入口 ───────────────────────────────────────────────────────────────
# 浏览器访问的站点源（生产必须 https，不能带路径）。
DSH_GATEWAY_PUBLIC_URL=http://127.0.0.1:8080
DSH_GATEWAY_LISTEN_HOST=127.0.0.1
DSH_GATEWAY_LISTEN_PORT=8080
DSH_GATEWAY_LOGIN_PATH=/login

# ── W3 身份提供方（AUTH_MODE=w3 时必填）───────────────────────────────────
W3_CLIENT_ID=
W3_CLIENT_SECRET=
W3_AUTHORIZE_URL=
W3_TOKEN_URL=
W3_USERINFO_URL=
W3_LOGOUT_URL=
W3_REDIRECT_URI=https://dsh.example.com/auth/callback
W3_SCOPE=base.profile
W3_TOKEN_REQUEST_FORMAT=json

# ── 开发/测试 Mock 身份（生产禁用）─────────────────────────────────────────
MOCK_USER_SUBJECT=dev-user-001
MOCK_USER_UID=local-001
MOCK_USER_DISPLAY_NAME=本地开发用户
MOCK_USER_EMAIL=

# ── Cookie 与会话 ──────────────────────────────────────────────────────────
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_NAME=dsh_session
AUTH_CSRF_COOKIE_NAME=dsh_csrf
AUTH_LOGIN_NONCE_COOKIE_NAME=dsh_login_nonce
AUTH_IDLE_TIMEOUT_MINUTES=120
AUTH_ABSOLUTE_TIMEOUT_MINUTES=720
AUTH_OAUTH_STATE_TTL_MINUTES=10

# 内部服务密钥（>=32 字符，生产必填；仅平台进程使用，不下发浏览器/Runtime）。
DSH_INTERNAL_API_KEY=
# 用户空间目录名 HMAC 密钥（>=32 字符，生产必填，轮换会使既有 space_key 变化）。
DSH_PLATFORM_SPACE_KEY_SECRET=

# ── Gateway 身份断言 ───────────────────────────────────────────────────────
DSH_GATEWAY_ISSUER=dsh-gateway
DSH_GATEWAY_AUDIENCE=dsh-web
DSH_GATEWAY_KEY_ID=dsh-gateway-key-v1
# 生产必须提供已存在的 Ed25519 私钥；公钥文件缺失时由私钥派生。
DSH_GATEWAY_SIGNING_PRIVATE_KEY_FILE=/srv/dsh/management/keys/gateway-ed25519-private.pem
DSH_GATEWAY_PUBLIC_KEY_FILE=/srv/dsh/management/keys/gateway-ed25519-public.pem
DSH_GATEWAY_ASSERTION_TTL_SECONDS=60
DSH_GATEWAY_WS_REVALIDATE_SECONDS=20

# ── 每用户 DSH Runtime ─────────────────────────────────────────────────────
# 开发：process（受限进程）；生产：container。
DSH_RUNTIME_KIND=process
DSH_RUNTIME_ROOT=/srv/dsh/spaces
DSH_RUNTIME_IDLE_SECONDS=1800
DSH_RUNTIME_REAP_INTERVAL_SECONDS=30
DSH_RUNTIME_START_TIMEOUT_MS=60000
DSH_RUNTIME_MAX_CONCURRENT_STARTS=4
# 进程后端命令（生产容器后端不使用；留空使用仓库默认 CLI）。
DSH_RUNTIME_PROCESS_COMMAND=
# 容器后端：镜像必须是不可变 digest；私有网络不发布端口。
DSH_RUNTIME_IMAGE=
DSH_RUNTIME_NETWORK=dsh-private
DSH_RUNTIME_DOCKER_COMMAND=docker
DSH_RUNTIME_CPU_LIMIT=1
DSH_RUNTIME_MEMORY_MB=2048
DSH_RUNTIME_PIDS_LIMIT=512
DSH_RUNTIME_CONTAINER_DATA_ROOT=/data
DSH_RUNTIME_CONTAINER_PORT=3080
DSH_RUNTIME_CONTAINER_UID=1000
DSH_RUNTIME_CONTAINER_PUBLIC_KEY_PATH=/run/dsh/gateway-public.pem
DSH_RUNTIME_CONTAINER_PATCH_PATH=/run/dsh/platform-runtime.patch.yml
# 必须与平台安装路径一致（生产容器后端会把该路径挂载进用户容器）。
DSH_RUNTIME_PATCH_FILE=/srv/dsh/current/deploy/runtime/platform-runtime.patch.yml

# ── 可选：系统融合分析（默认关闭）──────────────────────────────────────────
# 开启前必须完成 docs/integration/README.md 的前置条件；任何缺项都会让
# /api/integration/* 返回 503，而原生 W3 平台继续运行。生产必须使用
# container runner 与 Linux 主机。
DSH_INTEGRATION_ENABLED=false
DSH_INTEGRATION_SYSTEMS_FILE=/srv/dsh/management/integration/systems.json
DSH_INTEGRATION_DATA_DIR=/srv/dsh/management/integration
DSH_INTEGRATION_JOB_RUNNER_KIND=container
# 固定分析镜像；建议使用 digest。镜像不需要 entrypoint，runner 会清空它。
DSH_INTEGRATION_JOB_IMAGE=
DSH_INTEGRATION_JOB_NETWORK=none
# Gateway URL the per-user runtime calls; empty derives the local/container default.
DSH_INTEGRATION_RUNTIME_API_URL=
DSH_INTEGRATION_JOB_UID=1000
DSH_INTEGRATION_JOB_CPU_LIMIT=1
DSH_INTEGRATION_JOB_MEMORY_MB=1024
DSH_INTEGRATION_JOB_PIDS_LIMIT=256
DSH_INTEGRATION_JOB_TIMEOUT_SECONDS=900
DSH_INTEGRATION_MAX_ACTIVE_JOBS=2
DSH_INTEGRATION_DOCKER_COMMAND=docker

# ── 可选：模型服务（不得与 W3 平台身份混用）────────────────────────────────
# 用户级模型密钥应通过 DSH 界面写入各自 $DSH_HOME/.credentials.yaml；
# 这里只允许放部署级共享默认值，且不会回传给用户 Runtime。
DSH_PLATFORM_DEFAULT_LLM_KEY=
